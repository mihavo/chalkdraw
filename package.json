{
  "name": "chalkdraw",
  "displayName": "Chalkdraw",
  "description": "A chalkboard-inspired theme in four variants \u2014 Deep, Flat and Cool (dark) and Paper (light) \u2014 designed to minimize eye strain.",
  "version": "1.1.0",
  "publisher": "michaelvolakis",
  "license": "MIT",
  "icon": "resources/icon/chalkdraw.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mihavo/chalkdraw.git"
  },
  "bugs": {
    "url": "https://github.com/mihavo/chalkdraw/issues"
  },
  "homepage": "https://github.com/mihavo/chalkdraw#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "chalkboard",
    "warm",
    "low contrast",
    "eye strain",
    "minimal"
  ],
  "galleryBanner": {
    "color": "#17191B",
    "theme": "dark"
  },
  "scripts": {
    "build": "node src/build.js",
    "package": "npm run build && npx --yes @vscode/vsce package",
    "ink": "node scripts/try-ink.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Chalkdraw Deep",
        "uiTheme": "vs-dark",
        "path": "./themes/chalkdraw-deep.json"
      },
      {
        "label": "Chalkdraw Flat",
        "uiTheme": "vs-dark",
        "path": "./themes/chalkdraw-flat.json"
      },
      {
        "label": "Chalkdraw Paper",
        "uiTheme": "vs",
        "path": "./themes/chalkdraw-paper.json"
      },
      {
        "label": "Chalkdraw Cool",
        "uiTheme": "vs-dark",
        "path": "./themes/chalkdraw-cool.json"
      }
    ]
  }
}
