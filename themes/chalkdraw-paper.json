  "tokenColors": [
    {
      "name": "Global — no italics, no bold, anywhere",
      "scope": [
        "source",
        "text",
        "emphasis",
        "strong",
        "markup.italic",
        "markup.bold",
        "comment",
        "keyword",
        "variable.parameter",
        "entity.name.type"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E675A"
      }
    },
    {
      "name": "Punctuation & operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5C564D"
      }
    },
    {
      "name": "Identifier — variables, params, fields, object keys",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "name": "Keyword & storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "support.type.primitive",
        "variable.language"
      ],
      "settings": {
        "foreground": "#0B4EA8"
      }
    },
    {
      "name": "Type, class, namespace",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#00655A"
      }
    },
    {
      "name": "Function & method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#5C15B0"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9B3208"
      }
    },
    {
      "name": "Number & constant",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "variable.other.constant",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#22660B"
      }
    },
    {
      "name": "Fields & object keys — identifier color by design",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "meta.structure.dictionary.key",
        "support.type.property-name.json",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "name": "CSS values & units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#22660B"
      }
    },
    {
      "name": "JSON string values",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#9B3208"
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.sql",
        "keyword.other.DML"
      ],
      "settings": {
        "foreground": "#0B4EA8"
      }
    },
    {
      "name": "Python decorators & Go package",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#00655A"
      }
    },
    {
      "name": "Template/format placeholders",
      "scope": [
        "constant.other.placeholder",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#5C564D"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B3413B"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8A6A18"
      }
    },
    {
      "name": "Markdown — keyword",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#0B4EA8"
      }
    },
    {
      "name": "Markdown — bold -> identifier, weight-neutral",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "name": "Markdown — emphasis -> type, no italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#00655A"
      }
    },
    {
      "name": "Markdown — inline code -> string",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9B3208"
      }
    },
    {
      "name": "Markdown — links -> function",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#5C15B0"
      }
    },
    {
      "name": "Markdown — block quote -> comment",
      "scope": [
        "markup.quote",
        "beginning.punctuation.definition.quote.markdown"
      ],
      "settings": {
        "foreground": "#6E675A"
      }
    },
    {
      "name": "Markdown — list bullets -> punctuation",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#5C564D"
      }
    },
    {
      "name": "Markdown — diff added -> number",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#22660B"
      }
    },
    {
      "name": "Markdown — diff removed -> error",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B3413B"
      }
    },
    {
      "name": "No italics on comments/keywords/params/types (override)",
      "scope": [
        "comment",
        "keyword",
        "storage",
        "variable.parameter",
        "entity.name.type",
        "entity.other.attribute-name",
        "markup.italic",
        "markup.bold"
      ],
      "settings": {
        "fontStyle": ""
      }
    }
  ],
