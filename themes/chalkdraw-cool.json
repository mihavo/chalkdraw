  "tokenColors": [
    {
      "name": "Global — no italics, no bold, anywhere",
      "scope": [
        "source",
        "text",
        "emphasis",
        "strong",
        "markup.italic",
        "markup.bold",
        "comment",
        "keyword",
        "variable.parameter",
        "entity.name.type"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5B6675"
      }
    },
    {
      "name": "Punctuation & operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#C3CFDF"
      }
    },
    {
      "name": "Identifier — variables, params, fields, object keys",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A4BDD6"
      }
    },
    {
      "name": "Keyword & storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "support.type.primitive",
        "variable.language"
      ],
      "settings": {
        "foreground": "#5E97FF"
      }
    },
    {
      "name": "Type, class, namespace",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2FD8B6"
      }
    },
    {
      "name": "Function & method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#B79CE8"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#E8C79A"
      }
    },
    {
      "name": "Number & constant",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "variable.other.constant",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E4798D"
      }
    },
    {
      "name": "Fields & object keys — identifier color by design",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "meta.structure.dictionary.key",
        "support.type.property-name.json",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#A4BDD6"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#A4BDD6"
      }
    },
    {
      "name": "CSS values & units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E4798D"
      }
    },
    {
      "name": "JSON string values",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#E8C79A"
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.sql",
        "keyword.other.DML"
      ],
      "settings": {
        "foreground": "#5E97FF"
      }
    },
    {
      "name": "Python decorators & Go package",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#2FD8B6"
      }
    },
    {
      "name": "Template/format placeholders",
      "scope": [
        "constant.other.placeholder",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#C3CFDF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Markdown — keyword",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#5E97FF"
      }
    },
    {
      "name": "Markdown — bold -> identifier, weight-neutral",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#F2F0E8"
      }
    },
    {
      "name": "Markdown — emphasis -> type, no italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#2FD8B6"
      }
    },
    {
      "name": "Markdown — inline code -> string",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#E8C79A"
      }
    },
    {
      "name": "Markdown — links -> function",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#B79CE8"
      }
    },
    {
      "name": "Markdown — block quote -> comment",
      "scope": [
        "markup.quote",
        "beginning.punctuation.definition.quote.markdown"
      ],
      "settings": {
        "foreground": "#5B6675"
      }
    },
    {
      "name": "Markdown — list bullets -> punctuation",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#C3CFDF"
      }
    },
    {
      "name": "Markdown — diff added -> number",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#E4798D"
      }
    },
    {
      "name": "Markdown — diff removed -> error",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "No italics on comments/keywords/params/types (override)",
      "scope": [
        "comment",
        "keyword",
        "storage",
        "variable.parameter",
        "entity.name.type",
        "entity.other.attribute-name",
        "markup.italic",
        "markup.bold"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants — nil, true, false, iota (Cool)",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.iota"
      ],
      "settings": {
        "foreground": "#E4798D"
      }
    }
  ],
