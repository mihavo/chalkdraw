  "tokenColors": [
    {
      "name": "Global — no italics, no bold, anywhere",
      "scope": [
        "source",
        "text",
        "emphasis",
        "strong",
        "markup.italic",
        "markup.bold",
        "comment",
        "keyword",
        "variable.parameter",
        "entity.name.type"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8AA4"
      }
    },
    {
      "name": "Punctuation & operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8592A8"
      }
    },
    {
      "name": "Identifier — variables, params, fields, object keys",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BDCCE0"
      }
    },
    {
      "name": "Keyword & storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "support.type.primitive",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FF9C94"
      }
    },
    {
      "name": "Type, class, namespace",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5EE2C6"
      }
    },
    {
      "name": "Function & method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#8DB2FF"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8DD9A0"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EAB9FF"
      }
    },
    {
      "name": "Named constants & enum members",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EDAA72"
      }
    },
    {
      "name": "Parameter names in declarations",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#FFCE9C"
      }
    },
    {
      "name": "Imported module paths",
      "scope": [
        "entity.name.import",
        "storage.modifier.import",
        "meta.import string.quoted",
        "meta.import string"
      ],
      "settings": {
        "foreground": "#9EDCF2"
      }
    },
    {
      "name": "Fields & object keys — identifier color by design",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "meta.structure.dictionary.key",
        "support.type.property-name.json",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#BDCCE0"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#BDCCE0"
      }
    },
    {
      "name": "CSS values & units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#EAB9FF"
      }
    },
    {
      "name": "JSON string values",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#8DD9A0"
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.sql",
        "keyword.other.DML"
      ],
      "settings": {
        "foreground": "#FF9C94"
      }
    },
    {
      "name": "Python decorators & Go package",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#5EE2C6"
      }
    },
    {
      "name": "Template/format placeholders",
      "scope": [
        "constant.other.placeholder",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#8592A8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F07A83"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#EBC683"
      }
    },
    {
      "name": "Markdown — keyword",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#FF9C94"
      }
    },
    {
      "name": "Markdown — bold -> identifier, weight-neutral",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#BDCCE0"
      }
    },
    {
      "name": "Markdown — emphasis -> type, no italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#5EE2C6"
      }
    },
    {
      "name": "Markdown — inline code -> string",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#8DD9A0"
      }
    },
    {
      "name": "Markdown — links -> function",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#8DB2FF"
      }
    },
    {
      "name": "Markdown — block quote -> comment",
      "scope": [
        "markup.quote",
        "beginning.punctuation.definition.quote.markdown"
      ],
      "settings": {
        "foreground": "#7F8AA4"
      }
    },
    {
      "name": "Markdown — list bullets -> punctuation",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#8592A8"
      }
    },
    {
      "name": "Markdown — diff added -> string",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8DD9A0"
      }
    },
    {
      "name": "Markdown — diff removed -> error",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F07A83"
      }
    },
    {
      "name": "No italics on comments/keywords/params/types (override)",
      "scope": [
        "comment",
        "keyword",
        "storage",
        "variable.parameter",
        "entity.name.type",
        "entity.other.attribute-name",
        "markup.italic",
        "markup.bold"
      ],
      "settings": {
        "fontStyle": ""
      }
    }
  ],
